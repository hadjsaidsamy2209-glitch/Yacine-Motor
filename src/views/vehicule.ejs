<%- include('partials/header', { title: vehicle.marque + ' ' + vehicle.modele }) %>
<a class="back-link" href="/vehicules">← Tous les véhicules</a>

<header class="detail-header">
  <p class="vehicle-meta"><%= vehicle.annee %> · <%= vehicle.carburant %></p>
  <h1><%= vehicle.marque %> <%= vehicle.modele %></h1>
  <p class="detail-version"><%= vehicle.version %></p>
  <div class="vehicle-badges">
    <% if (vehicle.disponible) { %>
      <span class="badge badge-ok">Disponible</span>
    <% } else { %>
      <span class="badge badge-off">Indisponible<% if (vehicle.indisponible_jusqu_au) { %> jusqu'au <%= formatDate(vehicle.indisponible_jusqu_au) %><% } %></span>
    <% } %>
    <% if (vehicle.age_minimum) { %>
      <span class="badge"><%= vehicle.age_minimum %> ans min. · <%= vehicle.permis_minimum_annees %> ans de permis</span>
    <% } %>
  </div>
</header>

<div class="vehicle-visual vehicle-visual-large"><%= vehicle.categorie %></div>

<section class="price-panel" aria-label="Tarifs">
  <p class="price-main"><strong><%= formatPrice(vehicle.prix_jour) %></strong> / jour</p>
  <ul class="price-facts">
    <li>Caution : <strong><%= formatPrice(vehicle.caution) %></strong></li>
    <li><strong><%= vehicle.km_inclus_jour %> km</strong> inclus par jour</li>
  </ul>
</section>

<% if (vehicle.age_minimum) { %>
  <p class="notice">
    Ce véhicule est réservé aux conducteurs de <strong><%= vehicle.age_minimum %> ans minimum</strong>,
    titulaires du permis depuis au moins <strong><%= vehicle.permis_minimum_annees %> ans</strong>.
  </p>
<% } %>

<section class="detail-section">
  <h2>Caractéristiques</h2>
  <dl class="spec-list">
    <div><dt>Puissance</dt><dd><%= vehicle.puissance_ch %> ch</dd></div>
    <div><dt>Boîte</dt><dd><%= vehicle.boite %></dd></div>
    <div><dt>Transmission</dt><dd><%= vehicle.transmission %></dd></div>
    <div><dt>Kilométrage</dt><dd><%= vehicle.kilometrage.toLocaleString('fr-FR') %> km</dd></div>
    <div><dt>Places</dt><dd><%= vehicle.places %></dd></div>
    <div><dt>Portes</dt><dd><%= vehicle.portes %></dd></div>
    <div><dt>Couleur</dt><dd><%= vehicle.couleur %></dd></div>
    <div><dt>Crit'Air</dt><dd><%= vehicle.crit_air %></dd></div>
  </dl>
</section>

<section class="detail-section">
  <h2>Équipements</h2>
  <ul class="equipment-list">
    <% vehicle.equipements.forEach((equipment) => { %>
      <li><%= equipment %></li>
    <% }); %>
  </ul>
</section>

<section class="detail-section">
  <h2>Description</h2>
  <p><%= vehicle.description %></p>
</section>

<section class="detail-section" id="reservation">
  <h2>Demander une réservation</h2>
  <p class="form-intro">L'agence vous répond directement. Aucun paiement en ligne.</p>

  <% if (sendError) { %>
    <p class="notice notice-error" role="alert">
      Votre demande n'a pas pu être transmise. Réessayez dans un instant ou contactez directement l'agence.
    </p>
  <% } %>

  <% if (!minStart) { %>
    <p class="notice">Ce véhicule n'est pas réservable pour le moment.</p>
  <% } else { %>
    <% const hasConditions = Boolean(vehicle.age_minimum || vehicle.permis_minimum_annees); %>
    <% const messages = Object.values(errors); %>
    <form class="form-card" method="post" action="/vehicules/<%= vehicle.slug %>#reservation" data-price-per-day="<%= vehicle.prix_jour %>">
      <% if (messages.length > 0) { %>
        <div class="error-summary" role="alert">
          <p>Veuillez corriger les points suivants :</p>
          <ul>
            <% messages.forEach((message) => { %>
              <li><%= message %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <div class="field-row">
        <%- include('partials/form-field', { name: 'firstName', label: 'Prénom', type: 'text', value: form.firstName, error: errors.firstName, autocomplete: 'given-name' }) %>
        <%- include('partials/form-field', { name: 'lastName', label: 'Nom', type: 'text', value: form.lastName, error: errors.lastName, autocomplete: 'family-name' }) %>
      </div>

      <div class="field-row">
        <%- include('partials/form-field', { name: 'phone', label: 'Téléphone', type: 'tel', value: form.phone, error: errors.phone, autocomplete: 'tel' }) %>
        <%- include('partials/form-field', { name: 'email', label: 'Email', type: 'email', value: form.email, error: errors.email, autocomplete: 'email' }) %>
      </div>

      <div class="field-row">
        <%- include('partials/form-field', { name: 'startDate', label: 'Date de début', type: 'date', value: form.startDate, error: errors.startDate, min: minStart }) %>
        <%- include('partials/form-field', { name: 'endDate', label: 'Date de fin', type: 'date', value: form.endDate, error: errors.endDate, min: minStart }) %>
      </div>

      <% if (hasConditions) { %>
        <div class="field-row">
          <%- include('partials/form-field', { name: 'birthDate', label: 'Date de naissance', type: 'date', value: form.birthDate, error: errors.birthDate, hint: vehicle.age_minimum + ' ans minimum' }) %>
          <%- include('partials/form-field', { name: 'licenseDate', label: "Date d'obtention du permis", type: 'date', value: form.licenseDate, error: errors.licenseDate, hint: vehicle.permis_minimum_annees + ' ans de permis minimum' }) %>
        </div>
      <% } %>

      <div class="field">
        <label for="message">Message (facultatif)</label>
        <textarea id="message" name="message" rows="4" maxlength="1000"<% if (errors.message) { %> aria-invalid="true" aria-describedby="message-error"<% } %>><%= form.message || '' %></textarea>
        <% if (errors.message) { %>
          <p class="field-error" id="message-error"><%= errors.message %></p>
        <% } %>
      </div>

      <div class="consent">
        <input type="checkbox" id="consent" name="consent" required<% if (errors.consent) { %> aria-invalid="true" aria-describedby="consent-error"<% } %>>
        <label for="consent">J'accepte que mes données soient transmises à l'agence.</label>
      </div>
      <% if (errors.consent) { %>
        <p class="field-error" id="consent-error"><%= errors.consent %></p>
      <% } %>

      <div class="honeypot" aria-hidden="true">
        <label for="website">Ne pas remplir ce champ</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
      </div>

      <div class="price-box" id="price-box" hidden aria-live="polite">
        Prix total : <strong id="price-total"></strong>
      </div>

      <button class="button" type="submit">Envoyer la demande</button>
    </form>
  <% } %>
</section>
<script src="/js/price.js" defer></script>
<%- include('partials/footer') %>
