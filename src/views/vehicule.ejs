<%- include('partials/header', { title: vehicle.marque + ' ' + vehicle.modele, wide: true }) %>

<section class="band band-dark vehicle-hero">
  <div class="container">
    <a class="back-link" href="/vehicules">← Tous les véhicules</a>

    <div class="vehicle-hero-grid">
      <div>
        <p class="eyebrow"><%= vehicle.categorie %> · <%= vehicle.annee %> · <%= vehicle.carburant %></p>
        <h1><%= vehicle.marque %> <%= vehicle.modele %></h1>
        <p class="detail-version"><%= vehicle.version %></p>
        <div class="vehicle-badges">
          <% if (vehicle.disponible) { %>
            <span class="badge badge-ok">Disponible</span>
          <% } else { %>
            <span class="badge badge-off">Indisponible<% if (vehicle.indisponible_jusqu_au) { %> jusqu'au <%= formatDate(vehicle.indisponible_jusqu_au) %><% } %></span>
          <% } %>
          <% if (vehicle.age_minimum) { %>
            <span class="badge"><%= vehicle.age_minimum %> ans min. · <%= vehicle.permis_minimum_annees %> ans de permis</span>
          <% } %>
        </div>

        <% if (vehicle.image) { %>
          <figure class="vehicle-photo">
            <img src="<%= vehicle.image %>" alt="<%= vehicle.marque %> <%= vehicle.modele %>" width="480" height="170">
            <figcaption>Visuel illustratif</figcaption>
          </figure>
        <% } %>
      </div>

      <aside class="booking-card" aria-label="Tarif et réservation">
        <p class="booking-price"><strong><%= formatPrice(vehicle.prix_jour) %></strong> / jour</p>
        <% if (minStart) { %>
          <button type="button" class="button" data-open-dialog aria-haspopup="dialog">Demander une réservation</button>
          <p class="booking-note">Aucun paiement en ligne. L'agence vous répond directement.</p>
        <% } else { %>
          <p class="booking-note">Ce véhicule n'est pas réservable pour le moment.</p>
        <% } %>
      </aside>
    </div>
  </div>
</section>

<section class="band band-light">
  <div class="container">
    <ul class="key-specs">
      <li>
        <span class="stat-value"><%= vehicle.puissance_ch %></span>
        <p>chevaux</p>
      </li>
      <li>
        <span class="stat-value"><%= vehicle.places %></span>
        <p>places</p>
      </li>
      <li>
        <span class="stat-value stat-text"><%= vehicle.boite.split(' (')[0] %></span>
        <p>boîte</p>
      </li>
      <li>
        <span class="stat-value stat-text"><%= vehicle.transmission.split(' (')[0] %></span>
        <p>transmission</p>
      </li>
    </ul>
  </div>
</section>

<section class="band band-gray">
  <div class="container">
    <h2>Conditions de location</h2>
    <ul class="condition-cards">
      <li>
        <span class="condition-value"><%= formatPrice(vehicle.caution) %></span>
        <p>de caution</p>
      </li>
      <li>
        <span class="condition-value"><%= vehicle.km_inclus_jour %> km</span>
        <p>inclus par jour</p>
      </li>
      <li>
        <span class="condition-value">Crit'Air <%= vehicle.crit_air %></span>
        <p>vignette du véhicule</p>
      </li>
      <% if (vehicle.age_minimum) { %>
        <li>
          <span class="condition-value"><%= vehicle.age_minimum %> ans</span>
          <p>minimum, avec <%= vehicle.permis_minimum_annees %> ans de permis</p>
        </li>
      <% } %>
    </ul>
  </div>
</section>

<section class="band band-light">
  <div class="container">
    <h2>Caractéristiques</h2>
    <dl class="spec-list">
      <div><dt>Carburant</dt><dd><%= vehicle.carburant %></dd></div>
      <div><dt>Année</dt><dd><%= vehicle.annee %></dd></div>
      <div><dt>Kilométrage</dt><dd><%= vehicle.kilometrage.toLocaleString('fr-FR') %> km</dd></div>
      <div><dt>Boîte</dt><dd><%= vehicle.boite %></dd></div>
      <div><dt>Transmission</dt><dd><%= vehicle.transmission %></dd></div>
      <div><dt>Portes</dt><dd><%= vehicle.portes %></dd></div>
      <div><dt>Couleur</dt><dd><%= vehicle.couleur %></dd></div>
    </dl>
  </div>
</section>

<section class="band band-dark">
  <div class="container">
    <h2>Équipements</h2>
    <ul class="equipment-list">
      <% vehicle.equipements.forEach((equipment) => { %>
        <li><%= equipment %></li>
      <% }); %>
    </ul>
  </div>
</section>

<section class="band band-light">
  <div class="container">
    <h2>Description</h2>
    <p class="description-lead"><%= vehicle.description %></p>
  </div>
</section>

<section class="band band-gray cta-band">
  <div class="container cta-center">
    <h2>Ce véhicule vous intéresse ?</h2>
    <p>Envoyez votre demande : l'agence vous répond directement.</p>
    <div class="hero-actions">
      <% if (minStart) { %>
        <button type="button" class="button" data-open-dialog aria-haspopup="dialog">Demander une réservation</button>
      <% } %>
      <a class="text-link" href="/contact">Une question ? Contactez-nous</a>
    </div>
  </div>
</section>
<% if (minStart) { %>
<dialog id="reservation-dialog" class="reservation-dialog" aria-labelledby="reservation-title" data-open="<%= sendError || Object.keys(errors).length > 0 %>">
  <div class="dialog-panel">
    <div class="dialog-header">
      <div>
        <h2 id="reservation-title">Demander une réservation</h2>
        <p class="form-intro">L'agence vous répond directement. Aucun paiement en ligne.</p>
      </div>
      <button type="button" class="dialog-close" data-close-dialog aria-label="Fermer le formulaire">×</button>
    </div>

    <% if (sendError) { %>
      <p class="notice notice-error" role="alert">
        Votre demande n'a pas pu être transmise. Réessayez dans un instant ou contactez directement l'agence.
      </p>
    <% } %>

    <% const hasConditions = Boolean(vehicle.age_minimum || vehicle.permis_minimum_annees); %>
    <% const messages = Object.values(errors); %>
    <form class="form-card" method="post" action="/vehicules/<%= vehicle.slug %>" data-price-per-day="<%= vehicle.prix_jour %>">
      <% if (messages.length > 0) { %>
        <div class="error-summary" role="alert">
          <p>Veuillez corriger les points suivants :</p>
          <ul>
            <% messages.forEach((message) => { %>
              <li><%= message %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <div class="field-row">
        <%- include('partials/form-field', { name: 'firstName', label: 'Prénom', type: 'text', value: form.firstName, error: errors.firstName, autocomplete: 'given-name' }) %>
        <%- include('partials/form-field', { name: 'lastName', label: 'Nom', type: 'text', value: form.lastName, error: errors.lastName, autocomplete: 'family-name' }) %>
      </div>

      <div class="field-row">
        <%- include('partials/form-field', { name: 'phone', label: 'Téléphone', type: 'tel', value: form.phone, error: errors.phone, autocomplete: 'tel' }) %>
        <%- include('partials/form-field', { name: 'email', label: 'Email', type: 'email', value: form.email, error: errors.email, autocomplete: 'email' }) %>
      </div>

      <div class="field-row">
        <%- include('partials/form-field', { name: 'startDate', label: 'Date de début', type: 'date', value: form.startDate, error: errors.startDate, min: minStart }) %>
        <%- include('partials/form-field', { name: 'endDate', label: 'Date de fin', type: 'date', value: form.endDate, error: errors.endDate, min: minStart }) %>
      </div>

      <% if (hasConditions) { %>
        <div class="field-row">
          <%- include('partials/form-field', { name: 'birthDate', label: 'Date de naissance', type: 'date', value: form.birthDate, error: errors.birthDate, hint: vehicle.age_minimum + ' ans minimum' }) %>
          <%- include('partials/form-field', { name: 'licenseDate', label: "Date d'obtention du permis", type: 'date', value: form.licenseDate, error: errors.licenseDate, hint: vehicle.permis_minimum_annees + ' ans de permis minimum' }) %>
        </div>
      <% } %>

      <div class="field">
        <label for="message">Message (facultatif)</label>
        <textarea id="message" name="message" rows="4" maxlength="1000"<% if (errors.message) { %> aria-invalid="true" aria-describedby="message-error"<% } %>><%= form.message || '' %></textarea>
        <% if (errors.message) { %>
          <p class="field-error" id="message-error"><%= errors.message %></p>
        <% } %>
      </div>

      <div class="consent">
        <input type="checkbox" id="consent" name="consent" required<% if (errors.consent) { %> aria-invalid="true" aria-describedby="consent-error"<% } %>>
        <label for="consent">J'accepte que mes données soient transmises à l'agence.</label>
      </div>
      <% if (errors.consent) { %>
        <p class="field-error" id="consent-error"><%= errors.consent %></p>
      <% } %>

      <div class="honeypot" aria-hidden="true">
        <label for="website">Ne pas remplir ce champ</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
      </div>

      <div class="price-box" id="price-box" hidden aria-live="polite">
        Prix total : <strong id="price-total"></strong>
      </div>

      <button class="button" type="submit">Envoyer la demande</button>
    </form>
  </div>
</dialog>
<%# Sans JavaScript, la fenêtre ne pourrait pas s'ouvrir : on affiche alors le formulaire dans la page. %>
<noscript>
  <style>
    .reservation-dialog { display: block; position: static; width: min(100% - 2rem, 40rem); margin: 2rem auto; }
    .booking-card .button, .cta-band .button { display: none; }
  </style>
</noscript>
<script src="/js/reservation-dialog.js" defer></script>
<script src="/js/price.js" defer></script>
<% } %>
<%- include('partials/footer') %>
